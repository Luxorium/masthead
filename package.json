{
  "//": [
    "The product is Masthead. @luxorium/masthead is the package name inside the GitHub release tarball (luxorium-masthead-<version>.tgz).",
    "Masthead 0.2.0 is not published to npm: \"private\": true stays, so nothing can be published by accident.",
    "Install globally with --os=none --cpu=none (npm ignores --omit=optional for a global install): the Agent SDK's optional platform packages hold a private Claude Code binary that Masthead never uses (it always runs the person's own claude)."
  ],
  "name": "@luxorium/masthead",
  "version": "0.2.0",
  "description": "A local web app for running a tiered team of Claude agents through the Claude Code already installed on your machine.",
  "license": "MIT",
  "homepage": "https://github.com/Luxorium/masthead#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luxorium/masthead.git"
  },
  "bugs": {
    "url": "https://github.com/Luxorium/masthead/issues"
  },
  "keywords": [
    "claude",
    "agents",
    "multi-agent",
    "local",
    "web-app"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "masthead": "dist/server/main.js"
  },
  "files": [
    "dist/",
    "!dist/server/backends/codex/protocol/",
    "!dist/server/backends/codex/testing/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "check": "tsc -p tsconfig.server.json --noEmit && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --disable-warning=CLAUDE_SDK_CAN_USE_TOOL_SHADOWED dist/server/main.js serve",
    "test:live": "node --disable-warning=CLAUDE_SDK_CAN_USE_TOOL_SHADOWED --import tsx test/live.e2e.ts",
    "prepack": "npm run build",
    "test:web": "vitest run --config web/vitest.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.332",
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.11",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.1",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
