{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023"],
    "outDir": "dist", "rootDir": ".", "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "types": ["node"], "declaration": false, "sourceMap": false
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"]
}
